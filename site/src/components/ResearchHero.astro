---
import {Image} from 'astro:assets';
import portrait from '../../public/images/portrait.png';
import {MINIMAL} from '../data/minimal.mjs';
import {CONTENT,localize} from '../data/content.mjs';
import {UI,href} from '../../public/assets/i18n.mjs';
interface Props{lang:'en'|'es'|'de'|'nl'}
const {lang}=Astro.props,t=UI[lang],m=localize(MINIMAL,lang),content=localize(CONTENT.home,lang);
---
<section class="minimal-hero shell"><div class="minimal-hero-copy"><p class="eyebrow">Isaac Daroch</p><h1>{m.homeTitle}</h1><p class="lead">{m.homeLead}</p><p class="hero-identity">{content.identity}</p><div class="actions"><a class="button button-primary" href={href(lang,'self-model')}>{t.observatory} ↗</a><a class="button" href={href(lang,'cv')}>{t.cv}</a></div></div><figure class="real-portrait"><Image src={portrait} widths={[256,512]} sizes="(max-width: 768px) 70vw, 30vw" format="webp" alt="Isaac Daroch" loading="eager" fetchpriority="high"/></figure></section>
