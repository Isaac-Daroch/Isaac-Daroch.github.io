---
import BaseLayout from '../layouts/BaseLayout.astro';
import Preferences from './Preferences.astro';
import SelfObservatory from './SelfObservatory.astro';
import ArchiveFilters from './ArchiveFilters.astro';
import {SITE} from '../data/site.mjs';
import {sections,pathFor,records,publicationRecords,SOURCE,BRANCH_SOURCE} from '../data/editorial.mjs';
const {section='home',lang='en'}=Astro.props;const es=lang==='es';const t=(en,sp)=>es?sp:en;
const title=sections[section]?.[lang]??t('Page not found','Página no encontrada');
const pubs=publicationRecords();
const description=section==='home'?t('Isaac Daroch explores how experience, selective memory and internal state shape the decisions of adaptive agents. Research, publications and open code.','Isaac Daroch explora cómo experiencia, memoria selectiva y estado interno intervienen en las decisiones de agentes adaptativos. Investigación, publicaciones y código.'):t(`${title} — Isaac Daroch, research and scientific communication.`,`${title} — Isaac Daroch, investigación y divulgación científica.`);
const doiLink=p=>p.doi?.startsWith('https://')?p.doi:`https://doi.org/${p.doi}`;
const bib=p=>`@article{${p.id},\n  title = {${p.title}},\n  author = {${p.authors.join(' and ')}},\n  year = {${p.year}},\n  journal = {${p.journal}},\n  doi = {${p.doi}}\n}`;
---
<BaseLayout title={section==='home'?t('Experience shapes the agent','La experiencia construye al agente'):title} description={description} lang={lang} section={section}>
{section==='home'?<>
 <div class="shell"><section class="hero" aria-labelledby="home-title"><div><p class="eyebrow">{t('Artificial intelligence · Research & scientific communication','Inteligencia artificial · Investigación y divulgación científica')}</p><h1 id="home-title">{t('Same world.','Mismo mundo.')}<br/>{t('Different history.','Distinta historia.')}<span class="accent">{t('Another decision.','Otra decisión.')}</span></h1><p class="lede">{t('How does an agent learn what to expect of itself—and how does that change what it chooses to do?','¿Cómo aprende un agente qué esperar de sí mismo y cómo cambia eso lo que decide hacer?')}</p><p class="readable">{t('I explore the connections between retained experience, internal states and functional self-models. This site connects that research direction with inspectable experiments, published work and open code.','Exploro las conexiones entre experiencias conservadas, estados internos y modelos funcionales de sí mismo. Este sitio conecta esa dirección de investigación con experimentos examinables, publicaciones y código abierto a consulta.')}</p><div class="actions"><a class="button primary" href={pathFor('observatory',lang)}>{t('Explore the agent observatory','Explorar el observatorio del agente')}</a><a class="button" href={pathFor('publications',lang)}>{t('Read the evidence','Leer la evidencia')}</a></div></div><aside class="hero-aside"><div class="identity"><img class="portrait" src="/images/isaac-profile.jpg" alt="Isaac Daroch" width="108" height="108"/><div><strong>Isaac Daroch</strong><span class="meta">{t('PhD student · Advanced Systems Engineering','Estudiante de doctorado · Ingeniería de Sistemas Avanzados')}</span></div></div><p>{t('Not only a model of the world. A model of the agent within it.','No solo un modelo del mundo. Un modelo del agente que actúa en él.')}</p><ol class="process"><li><strong>{t('Experience','Experiencia')}</strong><br/>{t('Observe actions and consequences.','Observar acciones y consecuencias.')}</li><li><strong>{t('Selective memory','Memoria selectiva')}</strong><br/>{t('Retain what may matter; inspect what was replaced.','Conservar lo que puede importar; examinar lo reemplazado.')}</li><li><strong>{t('Self-model','Modelo propio')}</strong><br/>{t('Revise expectations about abilities and limitations.','Revisar expectativas sobre capacidades y límites.')}</li><li><strong>{t('Decision','Decisión')}</strong><br/>{t('Weigh a request alongside internal needs and uncertainty.','Ponderar una solicitud junto a necesidades internas e incertidumbre.')}</li></ol><a href={pathFor('about',lang)}>{t('About my work','Sobre mi trabajo')}</a></aside></section></div>
 <section class="section" id="research"><div class="shell"><div class="section-heading"><h2>{t('Questions that guide my work','Preguntas que guían mi trabajo')}</h2><a href={pathFor('investigations',lang)}>{t('Research archive','Archivo de investigación')}</a></div><div class="grid">{[[t('A constructed self-model','Un modelo propio construido'),t('Which experiences should change what an agent believes about its own abilities?','¿Qué experiencias deberían cambiar lo que un agente cree de sus capacidades?')],[t('Decisions with an internal history','Decisiones con historia interna'),t('When does a new situation lead it to act, verify, recover or reconsider a goal?','¿Cuándo una situación nueva lo lleva a actuar, comprobar, recuperarse o reconsiderar un objetivo?')],[t('Reliable applied intelligence','Inteligencia aplicada fiable'),t('How do we distinguish a technically valid operation from a faithful and useful answer?','¿Cómo distinguimos una operación técnicamente válida de una respuesta fiel y útil?')]].map(([name,question],i)=><article class="card"><span class="card-index">0{i+1}</span><h3>{name}</h3><p>{question}</p></article>)}</div></div></section>
 <section class="section" id="lab"><div class="shell grid two"><div><p class="eyebrow">{t('Interactive research direction','Dirección de investigación interactiva')}</p><h2>{t('Inspect what changes before an action changes.','Examina qué cambia antes de que cambie una acción.')}</h2><p>{t('Compare the same snapshot with a different energy level or with initial self estimates. Follow the selected memories and the exact contributions used by the decision rule.','Compara una misma instantánea con otra energía o con estimaciones propias iniciales. Sigue las memorias seleccionadas y los términos exactos utilizados por la regla de decisión.')}</p><a class="button primary" href={pathFor('observatory',lang)}>{t('Open the observatory','Abrir el observatorio')}</a></div><div class="card"><h3>{t('What this version can show','Qué puede mostrar esta versión')}</h3><p>{t('Learned success estimates. Bounded retained memory. Context-dependent decisions. Internally selected calibration and recovery. Controlled interventions and reproducible traces.','Estimaciones de éxito aprendidas. Memoria retenida limitada. Decisiones dependientes del contexto. Calibración y recuperación seleccionadas internamente. Intervenciones controladas y registros reproducibles.')}</p><p class="meta">{t('It cannot establish consciousness, free will or scientific generalization. The designed mechanisms and their limits are visible.','No establece conciencia, libre albedrío ni generalización científica. Los mecanismos diseñados y sus límites están visibles.')}</p></div></div></section>
 <section class="section" id="publications"><div class="shell"><div class="section-heading"><h2>{t('Published work','Trabajo publicado')}</h2><a href={pathFor('publications',lang)}>{t('Publication archive & citations','Archivo de publicaciones y citas')}</a></div>{pubs.slice(0,1).map(p=><article class="card"><span class="tag">{t('Published · institutional source','Publicado · fuente institucional')}</span><p class="meta">{p.year} · {p.journal}</p><h3><a href={doiLink(p)}>{p.title}</a></h3><p>{p.authors.join(', ')}</p><p>{t('Governed natural-language querying in a clinical scheduling pilot. Query syntax and answer reliability are different evaluation targets.','Consultas gobernadas en lenguaje natural en un piloto de agenda clínica. La sintaxis de una consulta y la fiabilidad de una respuesta son objetivos de evaluación distintos.')}</p><a href={pathFor('investigations',lang)+'#governed-query'}>{t('Question, method and limitations','Pregunta, método y limitaciones')}</a></article>)}</div></section>
 <section class="section"><div class="shell"><div class="section-heading"><h2>{t('Beyond the experiment','Más allá del experimento')}</h2></div><div class="grid">{['projects','events','news','media','teaching','about'].map((key,i)=><article class="card"><span class="card-index">0{i+1}</span><h3><a href={pathFor(key,lang)}>{sections[key][lang]}</a></h3><p>{key==='events'?t('Public event notes and materials, published only after verification.','Notas de eventos públicos y materiales, publicados solo tras verificación.'):key==='media'?t('Science explanations, professional social channels and accessible media.','Explicaciones científicas, canales profesionales y medios accesibles.'):key==='news'?t('Source-linked updates, with facts separated from editorial context.','Actualizaciones con fuentes; hechos separados de contexto editorial.'):t('Explore the work, context and available resources.','Explora el trabajo, su contexto y los recursos disponibles.')}</p></article>)}</div></div></section>
 <section class="section" id="connect"><div class="shell"><h2>{t('A conversation starts with a clear question.','Una conversación comienza con una pregunta clara.')}</h2><p class="readable">{t('Research collaboration, scientific communication and discussions about adaptive agents.','Colaboración en investigación, divulgación científica y conversaciones sobre agentes adaptativos.')}</p><div class="actions"><a class="button primary" href={pathFor('contact',lang)}>{t('Contact & professional networks','Contacto y redes profesionales')}</a><a class="button" href={pathFor('preferences',lang)}>{t('Accessibility preferences','Preferencias de accesibilidad')}</a></div></div></section>
</>:<div class="shell">
 <div class="page-intro"><nav class="breadcrumbs" aria-label={t('Breadcrumb','Ruta de navegación')}><ol><li><a href={pathFor('home',lang)}>{t('Home','Inicio')}</a></li><li aria-current="page">{title}</li></ol></nav><p class="eyebrow">Isaac Daroch · {t('Research & evidence','Investigación y evidencia')}</p><h1>{title}</h1></div>
 {section==='preferences'&&<Preferences lang={lang}/>}
 {section==='observatory'&&<><SelfObservatory lang={lang}/><section class="section body-copy"><h2>{t('Related reading','Lecturas relacionadas')}</h2><p>{t('These sources motivate distinct aspects of the direction; they are not validation of this prototype.','Estas fuentes motivan aspectos distintos de la dirección; no validan este prototipo.')}</p><ul><li><a href="https://doi.org/10.1126/science.1133687">Bongard, Zykov & Lipson — Resilient machines through continuous self-modeling (2006)</a></li><li><a href="https://arxiv.org/abs/1708.02190">Forestier et al. — Intrinsically Motivated Goal Exploration Processes (2017)</a></li><li><a href="https://aclanthology.org/P19-1434/">Episodic Memory Reader (2019)</a></li></ul><a href={BRANCH_SOURCE+'/site/src/modules/self-model'}>{t('Inspect the implementation','Examinar la implementación')}</a></section></>}
 {section==='investigations'&&<><p class="readable">{t('Each record separates the question, an accessible introduction, the technical mechanism and its limitations. A research direction is not automatically a published result.','Cada ficha separa pregunta, introducción divulgativa, mecanismo técnico y limitaciones. Una dirección de investigación no equivale automáticamente a un resultado publicado.')}</p><ArchiveFilters lang={lang} listId="research-archive"/><ul class="archive-list" id="research-archive">{records.researches.map(r=><li data-record data-topic={r.topic} data-year={r.year}><article id={r.id}><span class="tag">{r.status[lang]}</span><h2>{r.title[lang]}</h2><p class="readable"><strong>{r.question[lang]}</strong></p><div class="grid two"><div><h3>{t('In plain language','En palabras sencillas')}</h3><p>{r.plain[lang]}</p></div><div><h3>{t('Technical summary','Resumen técnico')}</h3><p>{r.technical[lang]}</p></div></div><div class="notice"><strong>{t('Limitations','Limitaciones')}</strong><p>{r.limitations[lang]}</p></div><div class="actions"><a class="button" href={pathFor(r.id==='self-model'?'observatory':'publications',lang)}>{r.id==='self-model'?t('Open the experiment','Abrir el experimento'):t('Publication & citation','Publicación y cita')}</a>{r.code&&<a href={r.code}>{t('Source code','Código fuente')}</a>}{r.source&&<a href={r.source}>{t('Institutional source','Fuente institucional')}</a>}</div></article></li>)}</ul></>}
 {section==='publications'&&<><p class="readable">{t('Bibliographic records and available versions. A local accessible summary does not guarantee accessibility of a publisher website. No private dataset or unauthorized PDF is republished.','Fichas bibliográficas y versiones disponibles. Un resumen local accesible no garantiza accesibilidad de la editorial. No se reproducen datos privados ni PDF sin autorización.')}</p><ArchiveFilters lang={lang} listId="publication-archive" topics={false}/><ul class="archive-list" id="publication-archive">{pubs.map(p=><li data-record data-year={p.year} data-topic="health"><article><p class="meta">{p.year} · {p.journal}</p><h2><a href={doiLink(p)}>{p.title}</a></h2><p>{p.authors.join(', ')}</p><span class="tag">{p.verifiedHere?t('Published · UNAB record checked 18 October 2026','Publicado · registro UNAB revisado el 18 de octubre de 2026'):t('Bibliographic record; status requires review','Ficha bibliográfica; estado por revisar')}</span><p><a href={doiLink(p)}>DOI: {p.doi}</a></p><div class="actions"><a class="button" href={pathFor('investigations',lang)+'#governed-query'}>{t('Read accessible summary','Leer resumen accesible')}</a>{p.institutionalUrl&&<a href={p.institutionalUrl}>{t('Institutional record','Registro institucional')}</a>}</div><details><summary>{t('Citation in BibTeX','Cita en BibTeX')}</summary><div><button type="button" data-copy={`bib-${p.id}`} disabled>{t('Copy citation','Copiar cita')}</button><p role="status" class="copy-status"></p><pre id={`bib-${p.id}`}><code>{bib(p)}</code></pre></div></details><p class="meta">{t('Code for the clinical pilot is not supplied in this record. Do not confuse the website repository with the study implementation.','Esta ficha no incluye código del piloto clínico. El repositorio de esta web no debe confundirse con la implementación del estudio.')}</p></article></li>)}</ul><a href="/publications.bib" download>{t('Download bibliography (BibTeX, English)','Descargar bibliografía (BibTeX, inglés)')}</a></>}
 {section==='projects'&&<><p class="readable">{t('Repositories are linked with their purpose and scope. Stars, forks and activity are not presented as live data.','Los repositorios se vinculan con propósito y alcance. No se presentan estrellas, bifurcaciones ni actividad como datos en vivo.')}</p><div class="grid two"><article class="card"><span class="tag">{t('Review candidate','Versión para revisión')}</span><h2>{t('Experiential agent observatory','Observatorio de agencia experiencial')}</h2><p>{t('A browser and headless experiment with explicit self estimates, selected memories, internal-state interventions and replay.','Experimento para navegador y ejecución sin interfaz con estimaciones propias, recuerdos seleccionados, intervenciones internas y reproducción.')}</p><div class="actions"><a class="button primary" href={pathFor('observatory',lang)}>{t('Run the experiment','Ejecutar el experimento')}</a><a href={BRANCH_SOURCE+'/site/src/modules/self-model'}>{t('Read source','Leer código')}</a></div></article><article class="card"><h2>{t('Research website & scientific notebook','Web de investigación y cuaderno científico')}</h2><p>Astro + Quarto · JavaScript · {t('Static publication','Publicación estática')}</p><p>{t('The source includes requirements, architectural decisions, test protocols and update/restoration tools. Existing D2 history remains available.','El código incluye requisitos, decisiones arquitectónicas, protocolos y herramientas de actualización y restauración. El historial D2 permanece disponible.')}</p><a href={SOURCE}>{t('Repository on GitHub','Repositorio en GitHub')}</a><p><a href={BRANCH_SOURCE+'/docs/a11y'}>{t('Candidate accessibility documentation','Documentación de accesibilidad de la versión')}</a></p></article></div><p class="notice">{t('Licensing: consult the repository notices. No new blanket license is assigned to the author’s text, photographs or third-party research.','Licencias: consulta los avisos del repositorio. No se asigna una licencia global nueva a textos, fotografías o investigación de terceros.')}</p></>}
 {section==='events'&&<div class="body-copy"><p>{t('A public journal of conferences, research schools and exchanges: date, place, confirmed role, materials and lessons. Maps or photographs will supplement—not replace—the event record.','Bitácora pública de congresos, escuelas de investigación e intercambios: fecha, lugar, rol confirmado, materiales y aprendizajes. Mapas y fotografías complementarán, no reemplazarán, las fichas.')}</p><div class="empty-state"><h2>{t('Event notes awaiting editorial confirmation','Bitácora pendiente de confirmación editorial')}</h2><p>{t('No travel or conference records have been approved for this version. Dates, participation, posters and future itineraries have not been inferred from private conversations.','No hay fichas de viajes o congresos aprobadas para esta versión. No se han inferido fechas, participaciones, pósteres ni itinerarios futuros a partir de conversaciones privadas.')}</p><a href={pathFor('contact',lang)}>{t('Contact about events and talks','Contacto sobre eventos y charlas')}</a></div></div>}
 {section==='news'&&<><p class="readable">{t('Selected source-linked updates, not an automatic or live feed. Event dates and editorial recording dates remain distinct.','Actualizaciones seleccionadas con fuentes, no un flujo automático ni en vivo. Se distinguen la fecha del hecho y la del registro editorial.')}</p><ArchiveFilters lang={lang} listId="news-archive"/><ul class="archive-list" id="news-archive">{records.news.map(r=><li data-record data-topic={r.topic} data-year={r.year}><article><p class="meta">{t('Source publication','Publicación de la fuente')}: {r.sourceDate} · {t('Recorded','Registrada')}: {r.recordedAt}</p><h2><a href={r.url}>{r.title[lang]}</a></h2><h3>{t('Source fact','Hecho de la fuente')}</h3><p>{r.facts[lang]}</p><h3>{t('Editorial context','Contexto editorial')}</h3><p>{r.comment[lang]}</p><a href={pathFor('publications',lang)}>{t('Related publication','Publicación relacionada')}</a></article></li>)}</ul></>}
 {section==='media'&&<div class="body-copy"><p>{t('Scientific communication should explain questions, methods and uncertainty—not merely show a polished result. Professional channels are linked below; no external player loads automatically.','La divulgación debe explicar preguntas, métodos e incertidumbre, no solo mostrar un resultado vistoso. Abajo se enlazan canales profesionales; ningún reproductor externo se carga automáticamente.')}</p><div class="empty-state"><h2>{t('No verified video catalog yet','Aún no hay catálogo audiovisual verificado')}</h2><p>{t('No YouTube, Instagram or X account, video URL, caption file or transcript has been invented. Videos will enter this archive with their original link, reviewed captions, an HTML transcript and visual description when needed.','No se inventó ninguna cuenta de YouTube, Instagram o X, URL de vídeo, archivo de subtítulos ni transcripción. Los vídeos ingresarán con su enlace original, subtítulos revisados, transcripción HTML y descripción visual cuando corresponda.')}</p></div><h2>{t('Professional channels','Canales profesionales')}</h2><p><a href={SITE.linkedin}>{t('LinkedIn: research updates and scientific communication','LinkedIn: novedades de investigación y divulgación científica')}</a></p><p><a href={pathFor('observatory',lang)}>{t('Explore the text-supported interactive explanation','Explorar la explicación interactiva con respaldo textual')}</a></p></div>}
 {section==='about'&&<div class="body-copy"><div class="identity"><img class="portrait" src="/images/isaac-profile.jpg" alt="Isaac Daroch" width="108" height="108"/><p>{t('PhD student in Advanced Systems Engineering; a completed master’s in informatics engineering; university teaching in Chile.','Estudiante de Doctorado en Ingeniería de Sistemas Avanzados, con magíster en Ingeniería Informática completado y docencia universitaria en Chile.')}</p></div><h2>{t('The question behind the work','La pregunta detrás del trabajo')}</h2><p>{t('My direction is to understand agents whose behavior is shaped by what they retain from experience, what they estimate about themselves and the situations they encounter. That includes adaptive intelligence, selective memory and the formation of internal goals.','Mi dirección es comprender agentes cuyo comportamiento esté influido por lo que conservan de la experiencia, lo que estiman sobre sí mismos y las situaciones que encuentran. Esto incluye inteligencia adaptativa, memoria selectiva y formación de objetivos internos.')}</p><p>{t('The long-term vision is intelligent digital beings and persistent digital worlds. It is a research ambition, not a claim that the website already implements consciousness or that every proposed capability is solved.','La visión de largo plazo son seres digitales inteligentes y mundos digitales persistentes. Es una ambición de investigación, no una afirmación de que la web ya implemente conciencia o resuelva todas las capacidades propuestas.')}</p><h2>{t('Trajectory and academic record','Trayectoria y registro académico')}</h2><p>{t('This page is an accessible profile, not a fabricated downloadable CV. Public research records are linked through ORCID and the publication archive. A complete reviewed CV can be added without making PDF the only way to read it.','Esta página es un perfil accesible, no un currículo descargable inventado. Los registros públicos se vinculan mediante ORCID y el archivo de publicaciones. Un CV completo revisado puede añadirse sin convertir el PDF en la única forma de leerlo.')}</p><p><a href={SITE.orcid}>ORCID · 0009-0006-3616-181X</a></p><a href={pathFor('publications',lang)}>{t('Publication record','Registro de publicaciones')}</a></div>}
 {section==='teaching'&&<div class="body-copy"><h2>{t('Learning through explicit reasoning','Aprender mediante razonamiento explícito')}</h2><p>{t('My teaching includes data mining in higher education in Chile. The emphasis is on asking clear questions, examining evidence, implementing reproducible analyses and understanding model limitations.','Mi docencia incluye minería de datos en educación superior en Chile. El énfasis está en formular preguntas claras, examinar evidencia, implementar análisis reproducibles y comprender límites de modelos.')}</p><p>{t('The notebook and agent observatory provide open explanations. These are not certificates, graded courses or a substitute for a course syllabus. Student information and restricted course materials are not published here.','El cuaderno y el observatorio aportan explicaciones abiertas. No son certificados, cursos evaluados ni sustitutos de un programa de asignatura. No se publican información de estudiantes ni materiales restringidos.')}</p><p><a href="/research/" lang="en">{t('Scientific notebook (English)','Cuaderno científico (inglés)')}</a></p><a href={pathFor('contact',lang)}>{t('Teaching enquiries','Consultas de docencia')}</a></div>}
 {section==='contact'&&<div class="body-copy"><p>{t('Research, collaboration, invited explanations and academic questions. These are confirmed professional channels; no account is required to contact by email.','Investigación, colaboración, explicaciones invitadas y consultas académicas. Estos son canales profesionales confirmados; no necesitas una cuenta para escribir por correo.')}</p><ul><li><a href={`mailto:${SITE.email}`}>{t('Email','Correo')}: {SITE.email}</a></li><li><a href={SITE.linkedin}>{t('LinkedIn: research and scientific communication','LinkedIn: investigación y divulgación científica')}</a></li><li><a href={SITE.github}>{t('GitHub: source code and repositories','GitHub: código fuente y repositorios')}</a></li><li><a href={SITE.orcid}>{t('ORCID: academic identity','ORCID: identidad académica')}</a></li></ul><div><button type="button" data-copy="contact-email" disabled>{t('Copy email','Copiar correo')}</button><p role="status" class="copy-status"></p><p id="contact-email">{SITE.email}</p></div><p class="notice">{t('This static site does not include a contact form that pretends to send a message. Email and named links are the available channels.','Este sitio estático no incluye un formulario que simule enviar mensajes. Los canales disponibles son el correo y los enlaces identificados.')}</p></div>}
 {section==='accessibility'&&<div class="body-copy"><h2>{t('Objective: WCAG 2.2 AA','Objetivo: WCAG 2.2 AA')}</h2><p>{t('This version is being evaluated against applicable level A and AA criteria. It does not claim complete conformance, universal accessibility or medical benefits from a color profile. Automated checks and human tests are distinct.','Esta versión se evalúa contra criterios aplicables A y AA. No declara conformidad completa, accesibilidad universal ni beneficios médicos de un perfil cromático. Las comprobaciones automáticas y las pruebas humanas son distintas.')}</p><p><a class="button primary" href={pathFor('preferences',lang)}>{t('Accessibility preferences','Preferencias de accesibilidad')}</a></p><h2>{t('Available access paths','Formas de acceso disponibles')}</h2><p>{t('Native keyboard controls, visible focus, a skip link, structured headings, local color and reading preferences, scalable text, reduced motion, text-backed experiment tables, and editorial content without JavaScript. The scientific notebook uses the same visual preferences and structured MathML equations.','Controles nativos de teclado, foco visible, salto al contenido, encabezados estructurados, preferencias locales de color y lectura, texto ampliable, movimiento reducido, tablas explicativas del experimento y contenido editorial sin JavaScript. El cuaderno científico utiliza las mismas preferencias y ecuaciones MathML estructuradas.')}</p><h2>{t('Verification still requiring people and devices','Verificación pendiente de personas y dispositivos')}</h2><p>{t('Real NVDA, VoiceOver and TalkBack task runs; voice-control operation; real browser zoom at 200% and 400%; device-level forced colors; scientific translation and alternative-text comprehension. These remain pending manual checks unless a specific evidence record states otherwise. No video captions or audio description are claimed for videos not yet supplied.','Recorridos reales con NVDA, VoiceOver y TalkBack; control por voz; zoom real de navegador al 200 % y 400 %; colores forzados del dispositivo; traducción científica y comprensión de alternativas textuales. Permanecen pendientes manuales salvo evidencia específica. No se afirman subtítulos ni audiodescripción de vídeos aún no proporcionados.')}</p><p><a href={BRANCH_SOURCE+'/docs/a11y/test-report.md'}>{t('Read the scoped test report','Leer el informe de pruebas delimitado')}</a> · <a href={BRANCH_SOURCE+'/docs/a11y/wcag-matrix.md'}>{t('55-criterion evaluation matrix','Matriz de evaluación de 55 criterios')}</a></p><h2>{t('Report a barrier','Informar una barrera')}</h2><p><a href={`mailto:${SITE.email}?subject=Website%20accessibility`}>{SITE.email}</a></p><p>{t('Include the page and task that caused difficulty, and browser or assistive technology only when you choose to share it. No diagnosis, phone call or visual challenge is required.','Incluye la página y la tarea que causó dificultad, y navegador o tecnología de apoyo solo cuando quieras compartirlos. No se exige diagnóstico, llamada ni prueba visual.')}</p></div>}
 {section==='privacy'&&<div class="body-copy"><h2>{t('Local preferences, no diagnosis','Preferencias locales, sin diagnósticos')}</h2><p>{t('Only interface preferences are stored under the site’s own browser key. They are not sent to analytics, placed in URLs or used to infer disability. Reset removes only this site’s preference keys. If storage fails, controls still operate within the current page session.','Solo se guardan preferencias de interfaz bajo una clave propia del navegador. No se envían a analítica, se incluyen en URL ni se utilizan para inferir discapacidad. Restablecer elimina solo las claves propias. Si falla el almacenamiento, los controles siguen operativos durante la sesión de la página.')}</p><h2>{t('Experiments and external services','Experimentos y servicios externos')}</h2><p>{t('Agent episodes run locally. Imported sessions are not uploaded. External links use their providers’ own privacy and accessibility policies; no social feed is embedded automatically. GitHub Pages serves this site and may process ordinary connection information under its service policies.','Los episodios del agente se ejecutan localmente. Las sesiones importadas no se suben. Los enlaces externos siguen políticas de privacidad y accesibilidad de sus proveedores; no se incrustan flujos sociales automáticamente. GitHub Pages sirve el sitio y puede procesar información ordinaria de conexión según sus políticas.')}</p><h2>{t('Ownership and source','Propiedad y fuentes')}</h2><p>{t('The original author’s content, third-party papers and dependency licenses retain their respective conditions. Consult the repository notices; this redesign does not assign a new blanket license. The portrait is the previously approved profile image.','Los contenidos originales, artículos de terceros y dependencias conservan sus condiciones respectivas. Consulta los avisos del repositorio; este rediseño no asigna una licencia global nueva. El retrato es la imagen de perfil previamente aprobada.')}</p><a href={SOURCE+'/blob/main/THIRD_PARTY_NOTICES.md'}>{t('Third-party notices','Avisos de terceros')}</a></div>}
 {section==='sitemap'&&<><p>{t('A complete text route through the editorial site. Spanish and English versions have equivalent local navigation. Notebook articles currently remain in English and are identified accordingly.','Ruta textual completa por el sitio editorial. Las versiones española e inglesa tienen navegación local equivalente. Los artículos del cuaderno permanecen en inglés y se identifican como tales.')}</p><ul>{Object.entries(sections).filter(([key])=>key!=='sitemap').map(([key,value])=><li><a href={pathFor(key,lang)}>{value[lang]}</a></li>)}<li><a href="/research/" lang="en">{t('Scientific notebook (English)','Cuaderno científico (inglés)')}</a></li></ul></>}
 {section==='engineering'&&<div class="body-copy"><h2>{t('One product, explicit boundaries','Un producto, límites explícitos')}</h2><p>{t('Astro renders the editorial site. Quarto builds scientific notes. A canonical JSON generates all 24 color palettes; a pure preference resolver is shared across both. The new self-model domain is separate from the historical gridworld and is accessed through a public session facade.','Astro genera el sitio editorial. Quarto construye notas científicas. Un JSON canónico genera las 24 paletas; un resolutor puro de preferencias se comparte entre ambos. El dominio de automodelado está separado del gridworld histórico y se accede mediante una fachada pública de sesión.')}</p><h2>{t('Decisions are not certification','Las decisiones no son certificación')}</h2><p>{t('Architectural checks, domain tests, rendered-page tests and human accessibility evaluation have different scopes. A green documentation check does not accept the behavior of an agent. This candidate is not automatically deployed to production.','Las comprobaciones arquitectónicas, pruebas del dominio, páginas renderizadas y evaluación humana de accesibilidad tienen alcances distintos. Una prueba documental aprobada no acepta el comportamiento del agente. Esta versión candidata no se despliega automáticamente en producción.')}</p><ul><li><a href={BRANCH_SOURCE+'/docs/a11y'}>{t('Accessibility specifications and evidence','Especificaciones y evidencia de accesibilidad')}</a></li><li><a href={BRANCH_SOURCE+'/docs/adr'}>{t('Architectural decisions and trade-offs','Decisiones arquitectónicas y trade-offs')}</a></li><li><a href={BRANCH_SOURCE+'/docs/d2'}>{t('Preserved D2 requirements','Requisitos D2 conservados')}</a></li><li><a href={BRANCH_SOURCE+'/tests/self-model.test.mjs'}>{t('Agent mechanism tests','Pruebas de mecanismos del agente')}</a></li></ul></div>}
 <div class="section"><a href={pathFor('home',lang)}>{t('Back to the home page','Volver al inicio')}</a></div>
