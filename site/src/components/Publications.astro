---
import publications from '../data/publications.json';
---
<section id="publications" class="section" aria-labelledby="publications-title"><div class="shell"><div class="section-top"><p class="eyebrow">03 / PUBLICATIONS</p><a class="text-link" href="https://orcid.org/0009-0006-3616-181X" target="_blank" rel="noopener noreferrer">ORCID ↗</a></div><div class="section-heading"><h2 id="publications-title" class="reveal">Follow<br/><em>the evidence.</em></h2><p>Source records, methods and limitations. Scientific publications are distinct from the educational experiments on this site.</p></div>{publications.filter(p=>p.status!=='draft').map(p=><article class="publication card reveal"><div class="publication-year mono">{p.year}<span class="badge">SOURCE RECORD</span></div><div><h3><a href={p.evidenceUrl} target="_blank" rel="noopener noreferrer">{p.title}</a></h3><p class="muted">{p.authors.join(', ')}</p><p>{p.journal} · {p.volume}({p.number}), {p.articleNumber}</p><div class="actions"><a class="text-link" href={p.evidenceUrl} target="_blank" rel="noopener noreferrer">DOI: {p.doi} ↗</a><a class="text-link" href="/references.bib" download>Download BibTeX ↓</a><a class="text-link" href={p.institutionalUrl} target="_blank" rel="noopener noreferrer">Institutional record ↗</a></div><p class="method-note">Bibliographic record retained from the portfolio’s audited sources. This website update does not re-audit the study’s experiments.</p></div></article>)}</div></section>
