---
import {STUDIO} from '../data/studio.mjs';import {localize} from '../data/content.mjs';
interface Props{lang:'en'|'es'|'de'|'nl'}const {lang}=Astro.props,t=localize(STUDIO,lang);
---
<div class="observatory-mode" data-no-speech><button data-studio-mode="guided" aria-pressed="true" disabled>{t.guided}</button><button data-studio-mode="technical" aria-pressed="false" disabled>{t.technical}</button></div>
<div class="agent-stage"><figure class="agent-scene"><svg id="agent-scene" viewBox="0 0 900 440" role="img" aria-labelledby="scene-title scene-description"><title id="scene-title">{t.scene}</title><desc id="scene-description">{t.sceneNote}</desc><g class="scene-grid" aria-hidden="true">{[0,1,2,3,4,5].map(i=><><path d={`M60 ${60+i*64} H840`} /><path d={`M${80+i*148} 35 V390`}/></>)}</g><g class="scene-connections"><path id="path-precision" d="M450 215 Q330 65 165 115"/><path id="path-analysis" d="M450 215 Q570 65 735 115"/><path id="path-recover" d="M450 215 V355"/></g><g class="scene-station"><rect x="65" y="65" width="200" height="110" rx="20"/><path d="M110 112 H150 M130 92 V132"/><text x="165" y="153" text-anchor="middle">{t.precision}</text></g><g class="scene-station"><rect x="635" y="65" width="200" height="110" rx="20"/><path d="M685 120 L705 100 L725 120 L750 85"/><text x="735" y="153" text-anchor="middle">{t.analysis}</text></g><g class="scene-station"><rect x="350" y="330" width="200" height="80" rx="20"/><text x="450" y="378" text-anchor="middle">{t.recover}</text></g><g class="scene-agent"><circle cx="450" cy="215" r="76" class="agent-aura"/><circle cx="450" cy="215" r="57"/><path d="M422 218 Q450 175 478 218 Q450 255 422 218Z"/><circle cx="450" cy="215" r="10"/><text x="450" y="306" text-anchor="middle">{t.agent}</text></g><g id="scene-memory" aria-hidden="true"></g></svg><figcaption><strong>{t.nextChoice}: </strong><span id="scene-choice">—</span><p>{t.sceneNote}</p></figcaption></figure><aside class="scenario-deck" data-no-speech><h3>{t.scenarios}</h3>{[['rested',t.rested],['tired',t.tired],['novel',t.novel],['pressure',t.pressure]].map(([id,label])=><button data-agent-scenario={id} disabled><span aria-hidden="true">↳</span>{label}</button>)}<button id="self-autoplay" class="button-primary" aria-pressed="false" disabled>{t.play}</button><p class="method-note">{t.motionNote}</p></aside></div>
<section class="guided-protocol" data-guided-only aria-labelledby="guide-heading"><h3 id="guide-heading">{t.guideTitle}</h3><div class="protocol-grid">{[1,2,3,4].map(i=><article><h4>{t['guide'+i]}</h4><p>{t['guide'+i+'p']}</p><button data-guide-step={i} disabled>{i===4?t.fork:t.try}</button></article>)}</div></section>
