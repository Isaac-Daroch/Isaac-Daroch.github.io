---
import {STUDIO} from '../data/studio.mjs';import {localize} from '../data/content.mjs';import {UI} from '../../public/assets/i18n.mjs';
interface Props{lang:'en'|'es'|'de'|'nl'}const {lang}=Astro.props,t=localize(STUDIO,lang),ui=UI[lang];
---
<section class="agent-panel timeline-panel" aria-labelledby="trajectory-heading"><h3 id="trajectory-heading">{t.timeline}</h3><p>{t.timelineNote}</p><figure><svg id="trajectory-plot" viewBox="0 0 900 280" role="img" aria-label={t.timeline}></svg><figcaption>{t.timelineLegend}</figcaption></figure><label for="decision-scrubber">{t.historyDetail}<input id="decision-scrubber" type="range" min="0" max="0" value="0" disabled/></label><div id="decision-inspection" class="decision-inspection">{t.empty}</div></section>
<section class="agent-panel fork-panel" aria-labelledby="fork-heading"><div class="section-heading"><h3 id="fork-heading">{t.guide4}</h3><button id="run-paired-experiment" disabled>{t.fork}</button></div><p>{t.forkNote}</p><div id="paired-results" class="paired-results" role="status">{t.forkEmpty}</div></section>
<div data-technical hidden><section class="agent-panel neural-instrument" aria-labelledby="network-heading"><div class="section-heading"><h3 id="network-heading">{t.network}</h3><label for="inspect-task">{t.inspectTask}<select id="inspect-task" disabled><option value="precision">{t.precision}</option><option value="analysis">{t.analysis}</option></select></label></div><p>{t.weightsNote}</p><p id="network-context"></p><button id="inspect-current-state" disabled>{t.currentContext}</button><figure><svg id="network-plot" viewBox="0 0 900 460" role="img" aria-label={t.network}></svg></figure><div id="neuron-choices" class="neuron-choices" aria-label={t.inspect}></div><div id="neuron-inspector" class="neuron-inspector" role="status"></div></section>
<div class="instrument-grid"><section class="agent-panel"><h3>{t.surface}</h3><p>{t.surfaceNote}</p><p><span>{t.energy} →</span> / <span>{t.fatigue} ↓</span></p><div class="surface-scroll" tabindex="0" role="region" aria-label={t.surface}><div id="capability-surface" class="capability-surface"></div></div><p id="surface-status" role="status"></p></section><section class="agent-panel"><h3>{t.loss}</h3><p>{t.lossNote}</p><figure><svg id="loss-plot" viewBox="0 0 650 320" role="img" aria-label={t.loss}></svg></figure><p id="training-summary"></p><details><summary>{t.table}</summary><table id="loss-table"><caption>{t.loss}</caption><thead><tr><th scope="col">{t.epoch}</th><th scope="col">{t.lossValue}</th></tr></thead><tbody></tbody></table></details></section></div>
<section class="agent-panel"><h3>{t.formula}</h3><p>{t.formulaNote}</p><div class="equation-steps"><code>x = [task, 2E − 1, 2F − 1, 2D − 1]</code><code>h₁ = tanh(W₁x + b₁) · h₂ = tanh(W₂h₁ + b₂)</code><code>p̂ = σ(w₃h₂ + b₃)</code><code>U(a) = external + learning + capability + risk + bodilyCost</code><code>a* = argmax U(a) · {ui.notAllowed}: E &lt; cost(a)</code></div><p class="method-note">{ui.retentionNote}</p></section></div>
