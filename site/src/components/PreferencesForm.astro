---
import {UI} from '../../public/assets/i18n.mjs';
interface Props {lang?:'en'|'de'|'nl'|'es'}
const {lang='en'}=Astro.props,t=UI[lang];
type Field=[string,string,string[],string[]];
const groups:{title:string;fields:Field[]}[]=[{title:t.visualGroup,fields:[['theme',t.theme,['system','light','dark'],[t.system,t.light,t.dark]],['appearance',t.appearance,['system','editorial','high','soft'],[t.system,t.standard,t.high,t.soft]],['colorProfile',t.profile,['editorial','redgreen','tritan','mono'],[t.graphite,t.redgreen,t.tritan,t.mono]]]},{title:t.readingGroup,fields:[['scale',t.textSize,['1','1.125','1.25','1.5','2'],['100 %','112,5 %','125 %','150 %','200 %']],['font',t.font,['system','editorial'],[t.systemFont,t.editorialFont]],['spacing',t.spacing,['normal','comfortable'],[t.standard,t.comfortable]]]},{title:t.motionGroup,fields:[['motion',t.motion,['reduce','system'],[t.reduce,t.system]],['dataMode',t.data,['system','standard','low'],[t.system,t.standard,t.lowData]]]}];
---
<section class="preferences-panel" aria-labelledby="preferences-heading"><h2 id="preferences-heading">{t.preferences}</h2><p>{t.presetNote}</p><noscript><p class="notice">{t.noJs}</p></noscript>
{groups.map((group,index)=><fieldset><legend>{group.title}</legend><div class="prefs-grid">{group.fields.map(([key,label,values,labels])=><label for={'pref-'+key}>{label}<select id={'pref-'+key} data-preference={key} disabled>{values.map((value,i)=><option value={value}>{labels[i]}</option>)}</select></label>)}</div>{index===1&&<><label class="switch-control"><input type="checkbox" data-preference="guidedReading" disabled/>{t.guided}</label><p>{t.focusNote}</p></>}</fieldset>)}
<p id="forced-colors-note" class="notice" hidden>{t.forced}</p><button id="reset-preferences" disabled>{t.reset}</button><p id="preferences-status" role="status"></p></section>
