---
interface Props{lang?:'en'|'es'}const{lang='en'}=Astro.props;const es=lang==='es';const t=(a:string,b:string)=>es?b:a;
const groups=[{legend:t('Visual presentation','Presentación visual'),fields:[{key:'theme',label:t('Theme','Tema'),options:[['system',t('System','Sistema')],['light',t('Light','Claro')],['dark',t('Dark','Oscuro')]]},{key:'appearance',label:t('Surface and contrast','Superficie y contraste'),options:[['system',t('System','Sistema')],['editorial',t('Standard Grafito','Grafito estándar')],['high',t('High contrast','Contraste alto')],['soft',t('Soft light','Luz suave')]]},{key:'colorProfile',label:t('Color profile','Perfil cromático'),options:[['editorial',t('Graphite and gold','Grafito y oro')],['redgreen',t('Blue–amber','Azul–ámbar')],['tritan',t('Cyan–raspberry','Cian–frambuesa')],['mono',t('Monochrome','Monocromo')]]}]},{legend:t('Reading','Lectura'),fields:[{key:'scale',label:t('Text size','Tamaño del texto'),options:[['1','100 %'],['1.125','112,5 %'],['1.25','125 %'],['1.5','150 %'],['2','200 %']]},{key:'font',label:t('Heading font','Fuente de títulos'),options:[['editorial',t('Editorial','Editorial')],['system',t('System font','Fuente del sistema')]]},{key:'spacing',label:t('Spacing','Espaciado'),options:[['normal',t('Standard','Normal')],['comfortable',t('Comfortable','Cómodo')]]}]},{legend:t('Motion and data','Movimiento y datos'),fields:[{key:'motion',label:t('Motion preference','Preferencia de movimiento'),options:[['reduce',t('Reduce (default)','Reducir (predeterminado)')],['system',t('Respect system','Respetar el sistema')]]},{key:'dataMode',label:t('Data usage','Uso de datos'),options:[['system',t('System','Sistema')],['standard',t('Standard','Estándar')],['low',t('Reduced data','Datos reducidos')]]}]}];
---
<section class="preferences-panel" aria-labelledby="preferences-heading"><h2 id="preferences-heading">{t('Accessibility preferences','Preferencias de accesibilidad')}</h2><p>{t('Choose the presentation you find easiest to read. No diagnosis is needed. These preferences do not replace keyboard, semantic structure or media alternatives.','Elige la presentación que te resulte más legible. No necesitas indicar un diagnóstico. Estas preferencias no sustituyen el teclado, la estructura semántica ni las alternativas multimedia.')}</p><noscript><p class="notice">{t('These optional controls require JavaScript. Content and navigation remain available with your system’s default presentation.','Estos ajustes opcionales requieren JavaScript. El contenido y la navegación siguen disponibles con la presentación predeterminada del sistema.')}</p></noscript>
{groups.map(group=><fieldset><legend>{group.legend}</legend><div class="prefs-grid">{group.fields.map(f=><label for={'pref-'+f.key}>{f.label}<select id={'pref-'+f.key} data-preference={f.key} disabled>{f.options.map(([v,label])=><option value={v}>{label}</option>)}</select></label>)}</div>{group.legend===t('Reading','Lectura')&&<label class="check-label" for="pref-readingMode"><input type="checkbox" id="pref-readingMode" data-preference="readingMode" disabled/>{t('Reading mode: one column, keep scientific content','Modo lectura: una columna, conservar contenido científico')}</label>}</fieldset>)}
<p>{t('Color profiles are alternatives, not corrections for a diagnosis. Soft light is not a treatment. Native browser zoom remains available. Motion requested by the operating system is always reduced.','Los perfiles son alternativas, no correcciones de un diagnóstico. Luz suave no es un tratamiento. El zoom nativo del navegador sigue disponible. Siempre se respeta la reducción de movimiento del sistema.')}</p><p id="forced-colors-note" class="notice" hidden>{t('Your operating system is currently controlling the colors. Your selection will return when forced colors are disabled.','Tu sistema operativo controla actualmente los colores. Tu selección se recuperará cuando desactives los colores forzados.')}</p>
<button id="reset-preferences" disabled>{t('Reset preferences','Restablecer preferencias')}</button><p id="preferences-status" role="status" aria-live="polite" aria-atomic="true"></p></section>
