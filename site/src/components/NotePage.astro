---
import BaseLayout from '../layouts/BaseLayout.astro';
import {NOTES} from '../data/notes.mjs';
import {localize} from '../data/content.mjs';
import {UI,href} from '../../public/assets/i18n.mjs';
interface Props{note:keyof typeof NOTES;lang:'en'|'de'|'nl'|'es'}
const {note,lang}=Astro.props,t=UI[lang],content=localize(NOTES[note],lang) as {title:string;lead:string;sections:{h:string;p:string[]}[]};
const latex=String.raw`o_t = \operatorname{observe}(W_t, p_t), \qquad M_{t+1}=\operatorname{revise}(M_t,o_t).`;
const code=note==='self-model'?`const agent = new ExperienceAgent();\nagent.run(12);\nconst comparison = agent.compare();\nconst record = agent.export();`: `const episode = createEpisode();\nepisode.intervene();\nwhile (!episode.snapshot().done) episode.step();\nconst record = episode.exportEpisode();`;
---
<BaseLayout lang={lang} title={content.title} description={content.lead}>
<article class="shell scientific-article"><header class="page-intro"><p class="eyebrow">{t.notebook}</p><h1>{content.title}</h1><p class="lead">{content.lead}</p></header><nav class="page-toc" aria-label={t.toc}><strong>{t.toc}</strong><ol>{content.sections.map((section,i)=><li><a href={'#note-section-'+i}>{section.h}</a></li>)}</ol></nav>
{content.sections.map((section,i)=><section class="narrative-section" id={'note-section-'+i}><h2>{section.h}</h2>{section.p.map(p=><p>{p}</p>)}{note==='two-maps'&&i===0&&<><div class="math-scroll" tabindex="0" role="region" aria-label={t.technical}><math display="block" xmlns="http://www.w3.org/1998/Math/MathML"><semantics><mrow><msub><mi>o</mi><mi>t</mi></msub><mo>=</mo><mi>observe</mi><mo>(</mo><msub><mi>W</mi><mi>t</mi></msub><mo>,</mo><msub><mi>p</mi><mi>t</mi></msub><mo>)</mo><mo>,</mo><mspace width="1em"/><msub><mi>M</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>=</mo><mi>revise</mi><mo>(</mo><msub><mi>M</mi><mi>t</mi></msub><mo>,</mo><msub><mi>o</mi><mi>t</mi></msub><mo>)</mo></mrow><annotation encoding="application/x-tex">{latex}</annotation></semantics></math></div><details><summary>LaTeX</summary><pre id="equation-source">{latex}</pre><button data-copy-target="equation-source" data-copy-status="equation-status" disabled>{t.copyCode}</button><p id="equation-status" role="status"></p></details></>}</section>)}
{['demo-protocol','self-model'].includes(note)&&<section class="narrative-section"><h2>{t.sourceCode}</h2><pre id="note-code"><code>{code}</code></pre><button data-copy-target="note-code" data-copy-status="note-code-status" disabled>{t.copyCode}</button><p id="note-code-status" role="status"></p></section>}
<nav class="related-notes" aria-label={t.notebook}><a href={href(lang,'research')}>{t.notebook} ↗</a><a href={href(lang,'self-model')}>{t.observatory} ↗</a><a href={href(lang,'projects')}>{t.sourceCode} ↗</a></nav><p class="method-note">{t.reviewPending}</p></article>
</BaseLayout>
