---
import {COURSES} from '../data/courses.mjs';import {STUDIO} from '../data/studio.mjs';import {localize} from '../data/content.mjs';import {UI} from '../../public/assets/i18n.mjs';import {classificationData} from '../modules/teaching/index.mjs';
interface Props{lang:'en'|'es'|'de'|'nl'}
const {lang}=Astro.props,t=localize(STUDIO,lang),ui=UI[lang];
---
<section class="teaching-overview"><p class="method-note">{t.teachingNote}</p><div class="course-grid">{COURSES.map((course,i)=><article class="course-card" id={'course-'+course.id}><span class="course-number">0{i+1}</span><h2>{course.name[lang]}</h2><p class="course-question">{course.question[lang]}</p><p>{course.description[lang]}</p><h3>{t.topics}</h3><ul>{course.units.map(unit=><li>{unit[lang]}</li>)}</ul><h3>{t.tools}</h3><p class="tool-chips">{course.tools.map(tool=><span>{tool}</span>)}</p><a class="button" href={'#teaching-lab'} data-course-select={course.id}>{t.try} ↗</a></article>)}</div></section>
<section id="teaching-lab" class="teaching-lab agent-panel" data-teaching-lab><div class="section-heading"><div><p class="eyebrow">{t.synthetic}</p><h2>{t.try}</h2></div><label for="course-focus">{t.lens}<select id="course-focus" disabled>{COURSES.map(c=><option value={c.id}>{c.name[lang]}</option>)}</select></label></div>
{COURSES.map(course=><p class="course-activity" data-course-description={course.id} hidden={course.id!=='mining'}>{course.activity[lang]}</p>)}
<div class="lesson-controls"><label data-course-control="mining" for="classification-threshold">{t.classification}<input id="classification-threshold" type="range" min="0" max="100" value="50" disabled/><output id="threshold-value" for="classification-threshold">50 %</output></label><label data-course-control="econometrics" for="confounding-strength" hidden>{t.confounding}<input id="confounding-strength" type="range" min="0" max="200" value="100" disabled/><output id="confounding-value" for="confounding-strength">1</output></label><label data-course-control="visualization" for="teaching-chart-type" hidden>{t.chartType}<select id="teaching-chart-type" disabled><option value="scatter">{t.scatter}</option><option value="bars">{t.bars}</option></select></label></div>
<div class="teaching-instruments"><figure class="teaching-plot"><svg id="teaching-plot" viewBox="0 0 700 380" role="img" aria-labelledby="teaching-plot-title teaching-plot-description"><title id="teaching-plot-title">{t.synthetic}</title><desc id="teaching-plot-description">{t.try}</desc></svg><figcaption id="teaching-plot-caption">{t.synthetic}</figcaption></figure><div id="teaching-metrics" class="teaching-metrics" role="status"></div></div><p id="econometrics-explanation" hidden>{t.confusionNote}</p><details><summary>{t.table}</summary><div class="table-scroll" tabindex="0" role="region" aria-label={t.table}><table id="teaching-data-table"><caption>{t.synthetic}</caption><thead><tr><th scope="col">ID</th><th scope="col">{t.classification}</th><th scope="col">{ui.outcome}</th></tr></thead><tbody>{classificationData.map(p=><tr><th scope="row">{p.id}</th><td>{p.score}</td><td>{p.label}</td></tr>)}</tbody></table></div></details><noscript><p>{ui.noJs}</p></noscript></section>
<script>import '../scripts/teaching.js';</script>
