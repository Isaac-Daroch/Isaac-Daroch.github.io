---
import {SITE} from '../data/site.mjs';
---
<section class="section connect-section" id="connect" aria-labelledby="connect-title"><div class="shell"><p class="eyebrow">CONNECT / COLLABORATE / QUESTION</p><h2 id="connect-title" class="reveal">Let’s ask<br/><em>better questions.</em></h2><div class="contact-layout"><p>For research conversations, collaborations and scientific communication. English and Spanish.</p><div class="contact-links"><a href={`mailto:${SITE.email}`}>{SITE.email} ↗</a><a href={SITE.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn ↗</a><a href={SITE.github} target="_blank" rel="noopener noreferrer">GitHub ↗</a><a href={SITE.orcid} target="_blank" rel="noopener noreferrer">ORCID ↗</a></div></div><p class="method-note">These links open external services; this site does not submit or store a contact form.</p></div></section>
