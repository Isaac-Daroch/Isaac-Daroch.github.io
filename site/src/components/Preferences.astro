---
const {lang='en'}=Astro.props;const es=lang==='es';
const labels={theme:es?'Tema':'Theme',appearance:es?'Superficie y contraste':'Surface and contrast',colorProfile:es?'Perfil cromático':'Color profile',scale:es?'Tamaño del texto':'Text size',font:es?'Tipografía de títulos':'Heading typeface',spacing:es?'Espaciado':'Spacing',motion:es?'Movimiento':'Motion',dataMode:es?'Uso de datos':'Data use'};
const fields=[['theme',[['system',es?'Sistema':'System'],['light',es?'Claro':'Light'],['dark',es?'Oscuro':'Dark']]],['appearance',[['system',es?'Sistema':'System'],['editorial',es?'Grafito estándar':'Standard graphite'],['high',es?'Contraste alto':'High contrast'],['soft',es?'Luz suave':'Soft light']]],['colorProfile',[['editorial',es?'Grafito y oro':'Graphite and gold'],['redgreen',es?'Azul–ámbar':'Blue–amber'],['tritan',es?'Cian–frambuesa':'Cyan–raspberry'],['mono',es?'Monocromo':'Monochrome']]],['scale',[['1','100 %'],['1.125','112.5 %'],['1.25','125 %'],['1.5','150 %'],['2','200 %']]],['font',[['editorial',es?'Editorial':'Editorial'],['system',es?'Fuente del sistema':'System typeface']]],['spacing',[['normal',es?'Normal':'Normal'],['comfortable',es?'Amplio':'Comfortable']]],['motion',[['reduce',es?'Reducido':'Reduced'],['system',es?'Respetar el sistema':'Follow system']]],['dataMode',[['system',es?'Sistema':'System'],['standard',es?'Estándar':'Standard'],['low',es?'Reducido':'Low data']]]];
---
<p class="readable">{es?'Elige la presentación que te resulte más legible. No necesitas indicar un diagnóstico. Las opciones cromáticas no corrigen una condición visual; las imágenes científicas no se recolorean.':'Choose the presentation that is easiest for you to read. No diagnosis is needed. Color profiles do not correct a visual condition, and scientific images are not recolored.'}</p>
<noscript><div class="notice">{es?'JavaScript está desactivado. El contenido y la navegación siguen disponibles; estas preferencias requieren JavaScript. Puedes utilizar el zoom y los colores de tu navegador o sistema.':'JavaScript is disabled. Content and navigation remain available; these preference controls require JavaScript. Browser zoom and system colors remain usable.'}</div></noscript>
<div class="notice" data-forced-notice hidden>{es?'Los colores efectivos los está controlando tu sistema. Conservaremos tu selección para cuando desactives ese ajuste.':'Your operating system currently controls the displayed colors. Your selection is preserved for when that setting is turned off.'}</div>
<form class="settings-form" onsubmit="return false">
 {[[es?'Presentación visual':'Visual presentation',fields.slice(0,3)],[es?'Lectura':'Reading',fields.slice(3,6)],[es?'Movimiento y datos':'Motion and data',fields.slice(6)]].map(([group,items])=><fieldset><legend>{group}</legend><div class="settings-grid">{items.map(([key,options])=><label>{labels[key]}<select data-preference={key} name={key} disabled>{options.map(([value,label])=><option value={value}>{label}</option>)}</select></label>)}</div>{group===(es?'Lectura':'Reading')&&<label class="check-label"><input type="checkbox" name="readingMode" data-preference="readingMode" disabled/>{es?'Modo lectura: una columna, sin ocultar información esencial':'Reading mode: one column without hiding essential information'}</label>}</fieldset>)}
 <p class="meta">{es?'Los cambios se aplican sin recargar. Se guardan solo en este navegador cuando es posible. El movimiento reducido del sistema siempre prevalece; no hay reproducción audiovisual automática.':'Changes apply without reloading and are saved only in this browser when possible. System reduced motion always takes precedence; audiovisual content never autoplays.'}</p>
 <button type="button" data-preferences-reset disabled>{es?'Restablecer preferencias':'Reset preferences'}</button>
 <p role="status" aria-live="polite" class="copy-status" data-preference-status></p>
</form>
