---
import {PAPERS,VIDEOS} from '../data/library.mjs';
import {RECENT_IDS,TIMELINE_IDS} from '../data/library-field.mjs';
import {STUDIO} from '../data/studio.mjs';import {MINIMAL} from '../data/minimal.mjs';
import {localize} from '../data/content.mjs';import {UI,href} from '../../public/assets/i18n.mjs';
import publications from '../data/publications.json';
interface Props{lang:'en'|'es'|'de'|'nl'}
const {lang}=Astro.props,t=localize(STUDIO,lang),m=localize(MINIMAL,lang),ui=UI[lang];
const recent=RECENT_IDS.map(id=>PAPERS.find(p=>p.id===id)!),history=TIMELINE_IDS.map(id=>PAPERS.find(p=>p.id===id)!);
---
<div class="research-library library-hub" data-resource-library>
<nav class="library-jumps" aria-label={m.libraryTitle}>{[['owned-publications',m.own,publications.length],['recent-papers',m.recent,recent.length],['field-history',m.history,history.length],['field-videos',m.videos,VIDEOS.length]].map(([id,title,count])=><a href={'#'+id}><span class="library-count" aria-hidden="true">{String(count).padStart(2,'0')}</span><span>{title}</span><span aria-hidden="true">↘</span></a>)}</nav>
<section id="owned-publications" class="library-section" aria-labelledby="owned-heading"><h2 id="owned-heading">{m.own}</h2><div class="paper-grid own-papers">{publications.filter(p=>p.status!=='draft').map(p=><article class="reading-card own-paper"><p class="paper-year">{p.year} <span>{ui.published}</span></p><h3 lang="en"><a href={p.evidenceUrl}>{p.title} ↗</a></h3><p>{p.journal} · {p.volume}({p.number}), {p.articleNumber}</p><div class="actions"><a href={href(lang,'publications')}>{m.details} ↗</a><a href={p.institutionalUrl}>{ui.source} ↗</a></div></article>)}</div></section>
<section id="recent-papers" class="library-section" aria-labelledby="recent-heading"><div class="section-heading"><h2 id="recent-heading">{m.recent}</h2><label class="resource-filter" for="resource-topic">{t.all}<select id="resource-topic" disabled>{['all','self','memory'].map(key=><option value={key}>{t[key]}</option>)}</select></label></div><p class="method-note">{m.recentNote}</p><p id="resource-count" role="status" data-label={t.found}></p><div class="paper-grid">{recent.map(p=><article class="reading-card" data-resource-topic={p.topic}><p class="paper-year">{p.year} <span>{t[p.topic]}</span></p><h3 lang="en"><a href={p.url}>{p.title} ↗</a></h3><p class="paper-authors">{p.authors}</p><p class="paper-status">{m[(p.status||'paper') as keyof typeof m]} · {p.venue}</p><p>{p.summary[lang]}</p><a href={p.source}>{ui.source} ↗</a></article>)}</div></section>
<section id="field-history" class="library-section" aria-labelledby="history-heading"><div class="section-heading"><h2 id="history-heading">{m.history}</h2></div><p>{m.historyNote}</p><nav class="timeline-index" aria-label={m.historyJump}>{history.map(p=><a href={'#milestone-'+p.id}>{p.year}<span class="sr-only"> · {p.title}</span></a>)}</nav><ol class="field-timeline">{history.map(p=><li id={'milestone-'+p.id}><div class="milestone-year"><span>{p.year}</span><span class="milestone-topic">{t[p.topic]}</span></div><article class="milestone-card"><h3 lang="en"><a href={p.url}>{p.title} ↗</a></h3><p>{p.summary[lang]}</p><p class="milestone-citation">{p.authors} · {p.venue}</p></article></li>)}</ol></section>
<section id="field-videos" class="library-section" aria-labelledby="videos-heading"><h2 id="videos-heading">{m.videos}</h2><p class="method-note">{m.videoPrivacy}</p><div class="video-grid">{VIDEOS.map(video=><article class="video-card"><div class="video-frame" data-video-slot><svg viewBox="0 0 640 180" aria-hidden="true"><circle cx="320" cy="90" r="46" fill="none" stroke="currentColor" stroke-width="2"/><path d="M309 70 L344 90 L309 110Z" fill="currentColor"/></svg><button data-video-load data-video-id={video.youtube} data-video-title={video.title[lang]} data-video-locale={lang} data-close-label={t.unload} disabled>{t.load}</button></div><div class="video-copy"><p class="eyebrow">{video.provider}</p><h3>{video.title[lang]}</h3><details><summary>{t.companion}</summary><p>{video.guide[lang]}</p></details><div class="actions"><a href={'https://www.youtube.com/watch?v='+video.youtube}>{t.openVideo} ↗</a><a href={PAPERS.find(p=>p.id===video.paper)!.url}>{t.read} ↗</a></div></div></article>)}</div></section>
</div>
<script>import '../scripts/library.js';</script>
