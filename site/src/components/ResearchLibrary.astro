---
import {PAPERS,VIDEOS} from '../data/library.mjs';import {STUDIO} from '../data/studio.mjs';import {localize} from '../data/content.mjs';import {UI,href} from '../../public/assets/i18n.mjs';
interface Props{lang:'en'|'es'|'de'|'nl';compact?:boolean;papersOnly?:boolean}
const {lang,compact=false,papersOnly=false}=Astro.props,t=localize(STUDIO,lang),ui=UI[lang],videos=compact?VIDEOS.slice(0,2):VIDEOS;
---
<section class="research-library section" data-resource-library aria-labelledby="resource-library-heading"><div class="section-heading"><div><p class="eyebrow">{t.external}</p><h2 id="resource-library-heading">{papersOnly?t.papers:t.library}</h2></div>{compact&&<a class="button" href={href(lang,'library')}>{ui.explore} ↗</a>}</div>{!compact&&<><label class="resource-filter" for="resource-topic">{t.all}<select id="resource-topic" disabled>{['all','self','curiosity','memory','world'].map(key=><option value={key}>{t[key]}</option>)}</select></label><p id="resource-count" role="status" data-label={t.found}></p></>}
{!papersOnly&&<section class="video-collection" aria-label={t.videos}><h3>{t.videos}</h3><div class="video-grid">{videos.map((video,index)=><article class="video-card" data-resource-topic={video.topic}><div class="video-frame" data-video-slot><svg viewBox="0 0 640 360" aria-hidden="true"><path d={index===1?'M80 240 Q200 20 320 180 T560 120':'M100 180 C160 30 460 30 540 180 C460 330 160 330 100 180Z'} fill="none" stroke="currentColor" stroke-width="2"/><circle cx="320" cy="180" r="60" fill="none" stroke="currentColor" stroke-width="2"/>{[0,1,2,3,4,5,6,7].map(n=><circle cx={320+180*Math.cos(n*Math.PI/4)} cy={180+100*Math.sin(n*Math.PI/4)} r="8" fill="currentColor"/>)}<path d="M306 155 L348 180 L306 205Z" fill="currentColor"/></svg><button data-video-load data-video-id={video.youtube} data-video-title={video.title[lang]} data-close-label={t.unload} disabled>{t.load}</button></div><div class="video-copy"><p class="eyebrow">{video.provider}</p><h4>{video.title[lang]}</h4><p>{t.providerNote}</p><details open><summary>{t.companion}</summary><p>{video.guide[lang]}</p></details><div class="actions"><a href={'https://www.youtube.com/watch?v='+video.youtube}>{t.openVideo} ↗</a><a href={video.source}>{t.source} ↗</a><a href={PAPERS.find(p=>p.id===video.paper)!.url}>{t.read} ↗</a></div></div></article>)}</div></section>}
<section aria-label={t.papers}><h3>{t.papers}</h3><div class="paper-grid">{(compact?PAPERS.slice(0,3):PAPERS).map(paper=><article class="reading-card" data-resource-topic={paper.topic}><p class="paper-year">{paper.year} <span>{t[paper.topic]}</span></p><h4 lang="en"><a href={paper.url}>{paper.title} ↗</a></h4><p>{paper.authors}</p><p class="badge">{paper.venue}</p><p>{paper.summary[lang]}</p><details><summary>{t.related}</summary><p>{paper.connection[lang]}</p></details><a href={paper.source}>{t.source} ↗</a></article>)}</div></section><p class="method-note">{t.verified}</p></section>
<script>import '../scripts/library.js';</script>
