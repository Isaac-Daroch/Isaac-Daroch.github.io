---
interface Props {lang?:'en'|'es'}
const {lang='en'}=Astro.props; const es=lang==='es';
const pages=[['/','Home','Inicio'],['/investigation/','Research questions','Preguntas de investigación'],['/publications/','Publications and citations','Publicaciones y citas'],['/projects/','Projects and code','Proyectos y código'],['/self-model/','Self-model observatory','Observatorio del modelo propio'],['/research/','Scientific notebook','Cuaderno científico'],['/about/','About Isaac and HTML background','Sobre Isaac y trayectoria en HTML'],['/events/','Conferences and field notes','Congresos y bitácora'],['/news/','Commented news','Noticias comentadas'],['/media/','Science communication','Divulgación'],['/teaching/','Teaching','Docencia'],['/contact/','Contact and professional networks','Contacto y redes profesionales'],['/accessibility/','Accessibility and preferences','Accesibilidad y preferencias'],['/privacy/','Privacy and credits','Privacidad y créditos'],['/engineering/','Engineering and verification limits','Construcción y límites de verificación']];
