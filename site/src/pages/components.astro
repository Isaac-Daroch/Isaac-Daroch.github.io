---
import BaseLayout from '../layouts/BaseLayout.astro';
import Preferences from '../components/Preferences.astro';
---
<BaseLayout title="Component verification fixture" description="Internal component review page; not a research result." noindex section="preferences">
<div class="shell page-intro"><h1>Component verification fixture</h1><p>This noindex page is a test fixture, not a real form or publication. It exposes relevant states for all 24 palettes.</p><Preferences/>
<section class="section" id="component-fixture"><h2>Controls and states</h2><p id="fixture-meta" class="meta">Informative metadata must remain legible.</p><p><a href="#sample-description" id="fixture-link">A named inline link</a> and <span class="accent" id="fixture-accent">editorial emphasis</span>.</p><div class="actions"><button type="button" class="primary" id="fixture-primary">Primary action</button><button type="button" aria-pressed="true">Selected toggle</button><button type="button" disabled>Unavailable action</button></div><label>Sample invalid field<input id="fixture-invalid" value="invalid sample" aria-invalid="true" aria-describedby="fixture-error"/></label><p id="fixture-error">Error: this fixture intentionally shows an invalid value. No data is sent.</p><label class="check-label"><input type="checkbox" checked/>Selected sample checkbox</label><details open><summary>Expanded information</summary><p id="sample-description">This text remains available in reading mode, at enlarged sizes and without JavaScript.</p></details><pre><code>const memory = experiences.slice(-8);</code></pre><div class="table-region" role="region" aria-label="Sample data table" tabindex="0"><table><caption>Sample values, explicitly a fixture</caption><thead><tr><th scope="col">Condition</th><th scope="col">Value</th></tr></thead><tbody><tr><th scope="row">Example A</th><td>1</td></tr></tbody></table></div><p><span class="tag">Published (fixture)</span><span class="tag">Under review (fixture)</span></p></section></div>
</BaseLayout>
