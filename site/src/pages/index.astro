import BaseLayout from '../layouts/BaseLayout.astro';import Hero from '../components/Hero.astro';import Research from '../components/Research.astro';import Story from '../components/Story.astro';import AgentDemo from '../components/AgentDemo.astro';import Publications from '../components/Publications.astro';import Projects from '../components/Projects.astro';import Contact from '../components/Contact.astro';
