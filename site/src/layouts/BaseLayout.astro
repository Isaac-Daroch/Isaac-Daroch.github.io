---
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/components.css';
import '../styles/print.css';
import {SITE,NAV,active} from '../data/site.mjs';
interface Props {title?:string; description:string; noindex?:boolean;}
const {title=SITE.title,description,noindex=false}=Astro.props;
const canonical=new URL(Astro.url.pathname,SITE.url).href;
---
<!doctype html>
<html lang="en" data-motion="reduced">
<head>
 <meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1.0"/>
 <title>{title} | Isaac Daroch</title><meta name="description" content={description}/><link rel="canonical" href={canonical}/>
 <meta name="theme-color" content="#08121b"/><meta name="referrer" content="strict-origin-when-cross-origin"/>
 {noindex&&<meta name="robots" content="noindex"/>}
 <meta property="og:type" content="website"/><meta property="og:title" content={`${title} | Isaac Daroch`}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/><meta property="og:image" content={`${SITE.url}/images/social.svg`}/><meta property="og:image:alt" content="Isaac Daroch — Adaptive intelligence and digital worlds"/>
 <meta name="twitter:card" content="summary_large_image"/><link rel="icon" type="image/svg+xml" href="/favicon.svg"/>
 <script type="application/ld+json" set:html={JSON.stringify({'@context':'https://schema.org','@type':'Person',name:SITE.name,url:SITE.url,sameAs:[SITE.github,SITE.orcid,SITE.linkedin]}).replace(/</g,'\u003c')}/>
</head>
<body>
 <a href="#main" class="skip-link">Skip to main content</a>
 <header class="site-header"><div class="shell header-inner"><a class="wordmark" href="/" aria-label="Isaac Daroch, home">ID<span class="brand-dot">.</span><span class="brand-name">ISAAC DAROCH</span></a>
 <nav class="desktop-nav" aria-label="Main navigation">{NAV.map(n=><a href={n.href} aria-current={active(n.href,Astro.url.pathname)?'page':undefined}>{n.label}</a>)}</nav>
 <div class="header-actions"><button id="motion-toggle" class="control" disabled aria-pressed="true"><span aria-hidden="true">◉</span> <span id="motion-label">Motion off</span></button><button id="menu-toggle" class="control menu-toggle" disabled aria-expanded="false" aria-controls="mobile-menu">Menu <span aria-hidden="true">＋</span></button></div></div>
 <nav id="mobile-menu" class="mobile-menu shell" aria-label="Mobile navigation" hidden>{NAV.map(n=><a href={n.href} aria-current={active(n.href,Astro.url.pathname)?'page':undefined}>{n.label}</a>)}<a href="/#connect">Contact</a></nav>
 <noscript><nav class="shell no-js-nav" aria-label="Navigation without JavaScript">{NAV.map(n=><a href={n.href}>{n.label}</a>)}</nav></noscript>
 </header>
 <main id="main" tabindex="-1"><slot/></main>
 <footer class="site-footer"><div class="shell"><div class="footer-top"><a class="wordmark" href="/">ID<span class="brand-dot">.</span></a><p>Understand the question.<br/><strong>Inspect the evidence.</strong></p><a class="text-link" href="/#connect">Start a conversation ↗</a></div><div class="footer-bottom"><span>© {new Date().getFullYear()} Isaac Daroch · Chile</span><nav aria-label="Footer navigation"><a href="/teaching/">Teaching</a><a href="/media/">Media</a><a href="/engineering/">How this is built</a><a href="/privacy/">Privacy & credits</a></nav></div></div></footer>
 <script>import '../scripts/main.js';</script>
</body>
</html>
