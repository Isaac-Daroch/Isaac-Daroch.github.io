---
import {SITE} from '../data/site.mjs';
import {sections,pathFor} from '../data/editorial.mjs';
interface Props {title?:string;description?:string;noindex?:boolean;lang?:'en'|'es';section?:string;}
const {title='Experience, self-models & adaptive agents',description='Isaac Daroch — research, evidence and an observatory of agent decisions.',noindex=false,lang='en',section='home'}=Astro.props;
const es=lang==='es';const canonical=new URL(Astro.url.pathname,SITE.url).href;
const primary=['investigations','publications','observatory'];const extra=['projects','events','news','media','teaching','about','sitemap'];
---
<!doctype html>
<html lang={lang}>
<head>
 <meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1.0"/>
 <title>{title} | Isaac Daroch</title><meta name="description" content={description}/><link rel="canonical" href={canonical}/>
 <meta name="referrer" content="strict-origin-when-cross-origin"/>
 {noindex&&<meta name="robots" content="noindex"/>}
 <link rel="alternate" hreflang="en" href={new URL(pathFor(section,'en'),SITE.url).href}/><link rel="alternate" hreflang="es" href={new URL(pathFor(section,'es'),SITE.url).href}/>
 <meta property="og:type" content="website"/><meta property="og:title" content={`${title} | Isaac Daroch`}/><meta property="og:description" content={description}/><meta property="og:image" content={`${SITE.url}/images/portrait.png`}/><meta property="og:image:alt" content="Isaac Daroch"/>
 <link rel="stylesheet" href="/ui/tokens.css"/><link rel="stylesheet" href="/ui/editorial.css"/>
 <script is:inline src="/ui/early.js"></script><script is:inline type="module" src="/ui/browser.mjs"></script>
</head>
<body>
 <a class="skip-link" href="#main">{es?'Saltar al contenido':'Skip to main content'}</a>
 <header class="site-header"><div class="shell header-inner">
  <a class="wordmark" href={pathFor('home',lang)}><span class="mark" aria-hidden="true">ID</span><span>Isaac Daroch</span></a>
  <nav class="header-links" aria-label={es?'Navegación principal':'Main navigation'}>
   {primary.map(key=><a class="primary-nav-link" href={pathFor(key,lang)} aria-current={section===key?'page':undefined}>{sections[key][lang]}</a>)}
   <details class="nav-disclosure"><summary>{es?'Explorar el sitio':'Explore the site'}</summary><ul>{[...primary,...extra].map(key=><li><a href={pathFor(key,lang)} aria-current={section===key?'page':undefined}>{sections[key][lang]}</a></li>)}<li><a href="/research/" lang="en">{es?'Cuaderno científico (inglés)':'Scientific notebook'}</a></li></ul></details>
   <a href={pathFor('accessibility',lang)} aria-current={section==='accessibility'?'page':undefined}>{es?'Accesibilidad':'Accessibility'}</a>
   <a href={pathFor(section,es?'en':'es')} lang={es?'en':'es'}>{es?'English':'Español'}</a>
  </nav>
 </div></header>
 <main id="main" tabindex="-1"><slot/></main>
 <footer class="site-footer"><div class="shell footer-grid"><div><strong>Isaac Daroch</strong><p class="meta">{es?'Investigar. Explicar. Hacer examinable.':'Research. Explain. Make it inspectable.'}</p></div><nav class="footer-links" aria-label={es?'Información y contacto':'Information and contact'}><a href={pathFor('contact',lang)}>{es?'Contacto y redes':'Contact & social'}</a><a href={pathFor('preferences',lang)}>{es?'Preferencias de accesibilidad':'Accessibility preferences'}</a><a href={pathFor('sitemap',lang)}>{es?'Mapa del sitio':'Site map'}</a><a href={pathFor('privacy',lang)}>{es?'Privacidad':'Privacy'}</a></nav></div></footer>
 <script>import '../scripts/editorial.mjs';</script>
</body>
</html>
