---
import {SITE} from '../data/site.mjs';
import {LOCALES,localeOf,logicalPath,href} from '../../public/assets/i18n.mjs';
import {renderChrome,renderFooter} from '../data/chrome.mjs';
interface Props {title?:string;description:string;noindex?:boolean;lang?:'en'|'de'|'nl'|'es';equivalent?:string;}
const {title=SITE.title,description,noindex=false}=Astro.props;
const lang=Astro.props.lang??localeOf(Astro.url.pathname),path=logicalPath(Astro.url.pathname);
const canonical=new URL(href(lang,path),SITE.url).href;
---
<!doctype html><html lang={lang} data-motion="reduced"><head>
<meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>{title} | Isaac Daroch</title><meta name="description" content={description}/><link rel="canonical" href={canonical}/>
<link rel="stylesheet" href="/assets/paletas.css"/><link rel="stylesheet" href="/assets/editorial.css"/>
<link rel="modulepreload" href="/assets/preferences-core.mjs"/><script is:inline type="module" src="/assets/preferences-runtime.mjs"></script>
<link rel="icon" type="image/svg+xml" href="/favicon.svg"/><meta name="referrer" content="strict-origin-when-cross-origin"/>
{noindex&&<meta name="robots" content="noindex"/>}<meta property="og:type" content="website"/><meta property="og:title" content={`${title} | Isaac Daroch`}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/>
{LOCALES.map(locale=><link rel="alternate" hreflang={locale} href={new URL(href(locale,path),SITE.url).href}/>)}
<script type="application/ld+json" set:html={JSON.stringify({'@context':'https://schema.org','@type':'Person',name:SITE.name,url:SITE.url,sameAs:[SITE.github,SITE.orcid,SITE.linkedin]}).replace(/</g,'\u003c')}/>
</head><body><Fragment set:html={renderChrome(lang,path,title)}/><main id="main" tabindex="-1"><slot/></main><Fragment set:html={renderFooter(lang)}/><script>import '../scripts/main.js';</script></body></html>
